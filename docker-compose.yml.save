services:
  telegram-bot-api:
    image: aiogram/telegram-bot-api:latest
    environment:
      TELEGRAM_API_ID: ${TELEGRAM_API_ID}
      TELEGRAM_API_HASH: ${TELEGRAM_API_HASH}
    volumes:
      - ./telegram-files:/var/lib/telegram-bot-api
    ports:
      - "8081:8081"

  bot:
    build: .
    depends_on:
      - telegram-bot-api
    environment:
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN}
      ALLOWED_USER_IDS: ${ALLOWED_USER_IDS:-}
      TELEGRAM_API_BASE: http://telegram-bot-api:8081
      TODOIST_API_KEY: ${TODOIST_API_KEY:-}
      IS_SANDBOX: 1
    volumes:
      - ./telegram-files:/app/telegram-files
      - ./dot-claude:/app/.claude
      - ./workspace:/app/workspace
      - ./venv:/venv
      - ./obsidian-vaults:/user-files/obsidian


    obsidian-sync:
    build: ./obsidian-headless
    container_name: obsidian-headless
    restart: unless-stopped
    environment:
      OB_EMAIL: ${OB_EMAIL}
      OB_PASSWORD: ${OB_PASSWORD}
      OB_VAULTS: ${OB_VAULTS}
      OB_E2EE_PASSWORD: ${OB_E2EE_PASSWORD:-}
      OB_SYNC_MODE: ${OB_SYNC_MODE:-bidirectional}
    volumes:
      - ./obsidian-vaults:/vaults
