# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...

# Your numeric Telegram user id (the only user allowed to use the bot)
ALLOWED_USER_ID=000000000

# OpenRouter API key
OPENROUTER_API_KEY=sk-or-...

# Telegram API credentials from https://my.telegram.org (for the local Bot API server)
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=00000000000000000000000000000000

# Todoist API token from https://todoist.com/prefs/integrations (for the Todoist action)
TODOIST_API_KEY=

# TickTick account login (for the TickTick action — uses the v2 API for full
# access, including Inbox tasks). The credentials are read from the environment
# only; they are never passed as command arguments or printed, so they don't
# appear in the bot's thinking log. The session token is cached under /workspace.
TICKTICK_USERNAME=
TICKTICK_PASSWORD=
# Only needed if the TickTick account has two-factor auth enabled:
# TICKTICK_TOTP_SECRET=

# Local timezone (IANA name). Sets what "today"/"tomorrow" mean for the bot and
# its scripts. Without this the container runs on UTC and dates can be off by a day.
TZ=America/New_York
