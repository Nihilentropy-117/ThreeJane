# Telegram
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=123456:your_bot_token
AUTHORIZED_USER_ID=123456789

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api...

# Agent config
AGENT_MODEL=claude-sonnet-4-20250514
AGENT_MAX_TURNS=10
AGENT_PERMISSION_MODE=acceptEdits
AGENT_ALLOWED_TOOLS=Bash,Read,Write,Edit,Glob,Grep,WebFetch,WebSearch,Agent

# Network
BOT_API_URL=http://telegram-bot-api:8081
AGENT_URL=http://agent:8082

# Bot storage
CONVERSATIONS_DB_PATH=/data/conversations/conversations.db
